# PostgreSQL (必填)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fryfroghub
DB_USERNAME=
DB_PASSWORD=

# Application
SERVER_PORT=20058
DB_POOL_SIZE=10
# Hibernate schema 策略：默认 validate（只校验不修改）。首次部署新增表（如 audiobooks）
# 时可临时设为 update 建表，建好后改回 validate
JPA_DDL_AUTO=validate

# TMDB
TMDB_API_KEY=

# Auth
AUTH_ENABLED=true
# 首次启动时用于创建初始管理员 admin 的密码；留空则自动生成随机密码（见启动日志）
AUTH_PASSWORD=
# Token 有效期（秒），默认 7 天
AUTH_TOKEN_TTL=604800
# 同一用户名连续登录失败多少次后锁定，默认 5 次
AUTH_LOGIN_MAX_FAILURES=5
# 锁定时长（分钟），默认 15 分钟
AUTH_LOGIN_LOCK_MINUTES=15
