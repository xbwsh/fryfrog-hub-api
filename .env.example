# SQLite（默认 data/fryfrog.db，可改路径）
SQLITE_PATH=data/fryfrog.db

# Application
SERVER_PORT=20058

# TMDB
TMDB_API_KEY=
TMDB_LANGUAGE=zh-CN

# Auth
AUTH_ENABLED=true
# 首次启动创建 admin 的密码；留空则自动生成随机密码（见启动日志）
AUTH_PASSWORD=
AUTH_TOKEN_TTL=604800
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15

# 媒体 / 代理（可选）
VIDEO_ROOT_PATHS=
FFMPEG_PATH=
PROXY_HOST=
PROXY_PORT=
SUBSONIC_ENCRYPT_KEY=

# 扫描 / 热监听
# 是否启用文件热监听（Linux 走 inotify，其他平台退回轮询）
WATCHER_ENABLED=true
# 是否保留周期性全量扫描（兜底，覆盖热监听漏掉的变化）
WATCHER_PERIODIC_SCAN=true
# 周期扫描间隔（分钟）
PERIODIC_SCAN_INTERVAL=30
# 文件消失后保留记录多久（秒）；宽限期满仍缺失才删行
SCAN_MISSING_GRACE_SECONDS=1800
# 本轮实见文件数低于上轮存量的该比例时，视为磁盘/挂载异常并暂缓删除
SCAN_GUARD_MIN_RATIO=0.5
